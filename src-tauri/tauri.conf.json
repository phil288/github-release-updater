{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Release Updater",
  "version": "0.1.0",
  "identifier": "dev.phil.gh-release-updater",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Release Updater",
        "width": 900,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi"],
    "category": "Utility",
    "publisher": "Philippe S",
    "homepage": "https://phil288.github.io/github-release-updater/",
    "copyright": "Copyright (c) 2026 Philippe S. MIT License.",
    "license": "MIT",
    "shortDescription": "Auto-update apps installed from GitHub releases",
    "longDescription": "Tray application that watches GitHub repositories and installs new .deb (Ubuntu) or .msi (Windows) release assets after your approval, with SHA-256 verification and the OS elevation prompt.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["pkexec"]
      }
    }
  }
}
